:9527 {
    # 安全响应头
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:"
        -Server
    }

    encode zstd gzip

    # IP 区域访问控制（启用时取消注释）
    # forward_auth 127.0.0.1:8888 {
    #   uri /api/internal/geo-check
    # }

    # API 反代后端
    handle /api/* {
        reverse_proxy 127.0.0.1:8888
    }

    # 前端构建产物，构建命令：cd frontend && pnpm -F logflux-web run build
    handle {
        root * ./frontend/apps/dist
        try_files {path} /index.html
        file_server {
            precompressed gzip
        }
    }
}
