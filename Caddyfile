{
    log {
        format console
    }
}

:9527 {
    # 安全响应头
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'"
        -Server
    }

    # 1. 前端静态资源 (构建后的文件)
    # 请确保您已执行 cd frontend && pnpm -F logflux-web run build
    root * ./frontend/apps/dist
    file_server

    # 2. IP 区域访问控制（启用时取消注释）
    # forward_auth 127.0.0.1:8888 {
    #   uri /api/internal/geo-check
    # }

    # 3. API 反向代理 (转发给 LogFlux 后端)
    reverse_proxy /api/* 127.0.0.1:8888

    # 4. SPA 单页应用路由支持
    # 如果请求的文件不存在，则返回 index.html，交给前端路由处理
    try_files {path} /index.html

    # 5. Gzip 压缩 (可选，提高加载速度)
    encode gzip
}
