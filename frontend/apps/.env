# 应用标题
VITE_APP_TITLE=LogFlux

# 应用命名空间，用于缓存、store 等功能的前缀
VITE_APP_NAMESPACE=LF

# 对 store 进行加密的密钥
VITE_APP_STORE_SECURE_KEY=logflux-store-key-2024

# 后端服务成功码
VITE_SERVICE_SUCCESS_CODE=0

# 后端服务登出码（收到即登出跳转登录页）
VITE_SERVICE_LOGOUT_CODES=401

# 弹窗式登出码（收到即弹窗提示后登出）
VITE_SERVICE_MODAL_LOGOUT_CODES=

# Token 过期码（收到即尝试刷新 token）
VITE_SERVICE_EXPIRED_TOKEN_CODES=

# 认证路由模式: static ｜ dynamic
VITE_AUTH_ROUTE_MODE=dynamic

# 默认首页路由
VITE_ROUTE_HOME=dashboard

# 静态路由模式下的超级管理员角色
VITE_STATIC_SUPER_ROLE=R_SUPER

# localStorage 前缀
VITE_STORAGE_PREFIX=LF_

# 路由历史模式（全环境锁定 hash，与 production 一致；禁止 history 漂移）
VITE_ROUTER_HISTORY=hash
