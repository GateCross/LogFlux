syntax = "v1"

import "base.api"

type (
	// 证书库存查询（单实例：没有 serverId 维度）
	CertificateListReq {
	}
	// 单张证书的库存投影
	CertificateItem {
		ID            uint   `json:"id"`
		Domains       string `json:"domains"`                    // SAN 列表，逗号分隔
		PrimaryDomain string `json:"primaryDomain"`              // 主域名（库存合并键）
		Issuer        string `json:"issuer"`                     // 签发者展示名
		Source        string `json:"source"`                     // acme_http | acme_dns | internal | upload | manual_declared
		NotBefore     string `json:"notBefore"`                  // 生效时间，ISO 字符串；声明行无真值为空
		NotAfter      string `json:"notAfter"`                   // 到期时间，ISO 字符串；声明行无真值为空
		LastSyncedAt  string `json:"lastSyncedAt"`               // 最近一次同步时间，ISO 字符串
		StoragePath   string `json:"storagePath"`                // 证书文件路径
		Status        string `json:"status"`                     // valid | expiring | expired | missing | pending
		DaysLeft      int    `json:"daysLeft"`                   // 距到期天数；pending/missing/已过期为 0
	}
	CertificateListResp {
		List []CertificateItem `json:"list"`
	}
	// 证书上传：multipart 表单（cert/key 两个 PEM 文件 + domains 可选），
	// 非文件字段沿用 form 标签
	CertificateUploadReq {
		Domains string `form:"domains,optional"` // 补充域名，逗号分隔，与证书 SAN 合并展示
	}
)

@server (
	prefix: /api
	group:  caddy
	jwt:    Auth
	middleware: ActiveUser
)
service logflux-api {
	@handler ListCertificates
	get /caddy/certificates (CertificateListReq) returns (CertificateListResp)

	@handler UploadCertificate
	post /caddy/certificates/upload (CertificateUploadReq) returns (BaseResp)

	@handler RefreshCertificates
	post /caddy/certificates/refresh returns (BaseResp)

	@handler DeleteCertificate
	delete /caddy/certificates/:id (IDReq) returns (BaseResp)
}
