syntax = "v1"

import "base.api"

type (
	// Caddy 管理
	//
	// 单实例：不存在「多个节点」，因此没有服务器 CRUD，也没有 serverId 路径参数。
	// caddy_servers 表只保留 Admin API 连接信息，由启动播种维护。
	// Docker 发现：标签扫描 → 仅会话级候选（无发现库，永不自动 /load）
	DockerDiscoveryCandidate {
		CandidateId    string   `json:"candidateId"`
		ContainerId    string   `json:"containerId"`
		ContainerName  string   `json:"containerName"`
		Status         string   `json:"status"`
		Name           string   `json:"name"`
		Domains        []string `json:"domains"`
		Upstream       string   `json:"upstream"`
		LbPolicy       string   `json:"lbPolicy,optional"`
		TlsMode        string   `json:"tlsMode"`
		HealthPath     string   `json:"healthPath,optional"`
		HealthInterval string   `json:"healthInterval,optional"`
		HealthTimeout  string   `json:"healthTimeout,optional"`
		Reason         string   `json:"reason,optional"`
		Valid          bool     `json:"valid"`
	}
	DockerDiscoveryResp {
		List      []DockerDiscoveryCandidate `json:"list"`
		ScannedAt string                     `json:"scannedAt"`
		Message   string                     `json:"message,optional"`
	}
	// 代理配置
	CaddyConfigUpdateReq {
		Mode     string `json:"mode,optional"` // quick | raw；为空时兼容旧版请求
		Config   string `json:"config,optional"` // 原始 Caddyfile 或前端兜底生成结果
		Modules  string `json:"modules,optional"` // 结构化配置(JSON)
		BaseHash string `json:"baseHash,optional"` // 编辑起点配置哈希；不一致说明他人已改
	}
	CaddyConfigPreviewReq {
		Mode     string `json:"mode,optional"` // quick | raw；为空时根据 modules 自动判断
		Config   string `json:"config,optional"` // 原始 Caddyfile 或前端兜底生成结果
		Modules  string `json:"modules,optional"` // 结构化配置(JSON)
		BaseHash string `json:"baseHash,optional"` // 预览时同样做漂移检测
	}
	CaddyConfigPreviewResp {
		Valid   bool     `json:"valid"`
		Config  string   `json:"config"`
		Errors  []string `json:"errors"`
		Actions []string `json:"actions"`
	}
	CaddyConfigResp {
		Config string `json:"config"`
		Modules string `json:"modules,optional"`
		Hash string `json:"hash,optional"` // 当前库内配置哈希；写请求回传做乐观并发
	}
	CaddyConfigHistoryListReq {
		Page     int  `form:"page,default=1"`
		PageSize int  `form:"pageSize,default=20"`
	}
	CaddyConfigHistoryItem {
		ID        uint   `json:"id"`
		ServerId  uint   `json:"serverId"`
		Action    string `json:"action"`
		Hash      string `json:"hash"`
		CreatedAt string `json:"createdAt"`
	}
	CaddyConfigHistoryListResp {
		List  []CaddyConfigHistoryItem `json:"list"`
		Total int64                    `json:"total"`
	}
	CaddyConfigHistoryDetailReq {
		HistoryId uint `path:"historyId"`
	}
	CaddyConfigHistoryDetailResp {
		ID        uint   `json:"id"`
		ServerId  uint   `json:"serverId"`
		Action    string `json:"action"`
		Hash      string `json:"hash"`
		Config    string `json:"config"`
		Modules   string `json:"modules,optional"`
		CreatedAt string `json:"createdAt"`
	}
	CaddyConfigRollbackReq {
		HistoryId uint   `json:"historyId"`
		BaseHash  string `json:"baseHash,optional"` // 回滚起点配置哈希；不一致说明他人已改
	}
)

@server (
	prefix: /api
	group:  caddy
	jwt:    Auth
	middleware: ActiveUser
)
service logflux-api {
	@handler DiscoverDockerServices
	get /caddy/discovery/docker returns (DockerDiscoveryResp)

	@handler GetCaddyConfig
	get /caddy/config returns (CaddyConfigResp)

	@handler UpdateCaddyConfig
	post /caddy/config (CaddyConfigUpdateReq) returns (BaseResp)

	@handler PreviewCaddyConfig
	post /caddy/config/preview (CaddyConfigPreviewReq) returns (CaddyConfigPreviewResp)

	@handler GetCaddyConfigHistory
	get /caddy/config/history (CaddyConfigHistoryListReq) returns (CaddyConfigHistoryListResp)

	@handler GetCaddyConfigHistoryDetail
	get /caddy/config/history/:historyId (CaddyConfigHistoryDetailReq) returns (CaddyConfigHistoryDetailResp)

	@handler RollbackCaddyConfig
	post /caddy/config/rollback (CaddyConfigRollbackReq) returns (BaseResp)
}
