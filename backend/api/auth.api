syntax = "v1"

type (
	// Auth
	LoginReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	RefreshTokenReq {
		RefreshToken string `json:"refreshToken"`
	}
	LoginResp {
		Token        string `json:"token"`
		RefreshToken string `json:"refreshToken"`
	}
	SetupStatusResp {
		// Initialized 为 false 时表示还没有任何账号，前端应引导创建首个管理员
		Initialized bool `json:"initialized"`
	}
	SetupReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}
)

@server (
	prefix: /api
	group:  auth
)
service logflux-api {
	@handler Login
	post /login (LoginReq) returns (LoginResp)

	@handler RefreshToken
	post /refreshToken (RefreshTokenReq) returns (LoginResp)

	@handler GetSetupStatus
	get /setup/status returns (SetupStatusResp)

	@handler Setup
	post /setup (SetupReq) returns (LoginResp)
}
