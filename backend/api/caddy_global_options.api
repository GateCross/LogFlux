syntax = "v1"

import "base.api"

type (
	// Caddy Global Options & Entry Block
	CaddyGlobalOptionsResp {
		AutoHttps       string   `json:"autoHttps,optional"`
		TrustedProxies  []string `json:"trustedProxies,optional"`
		Debug           bool     `json:"debug,optional"`
		Email           string   `json:"email,optional"`
		ExtraRawOptions string   `json:"extraRawOptions,optional"`
	}
	CaddyGlobalOptionsUpdateReq {
		AutoHttps       string   `json:"autoHttps,optional"`
		TrustedProxies  []string `json:"trustedProxies,optional"`
		Debug           bool     `json:"debug,optional"`
		Email           string   `json:"email,optional"`
		ExtraRawOptions string   `json:"extraRawOptions,optional"`
	}
	CaddyEntryBlockResp {
		Raw string `json:"raw"`
	}
	CaddyEntryBlockUpdateReq {
		Raw            string `json:"raw,optional"`
		SyncFromConfig bool   `json:"syncFromConfig,optional"`
	}
	// Caddy Log Snippet（参数化站点日志 snippet 定义）
	CaddyLogSnippetResp {
		Raw string `json:"raw"`
	}
	CaddyLogSnippetUpdateReq {
		Raw string `json:"raw,optional"`
	}
)

@server (
	prefix: /api
	group:  caddy
	jwt:    Auth
	middleware: ActiveUser
)
service logflux-api {
	@handler GetCaddyGlobalOptions
	get /caddy/global-options returns (CaddyGlobalOptionsResp)

	@handler UpdateCaddyGlobalOptions
	put /caddy/global-options (CaddyGlobalOptionsUpdateReq) returns (CaddyGlobalOptionsResp)

	@handler GetCaddyEntryBlock
	get /caddy/entry-block returns (CaddyEntryBlockResp)

	@handler UpdateCaddyEntryBlock
	put /caddy/entry-block (CaddyEntryBlockUpdateReq) returns (CaddyEntryBlockResp)

	@handler ResetCaddyEntryBlock
	post /caddy/entry-block/reset-default returns (CaddyEntryBlockResp)

	@handler GetCaddyLogSnippet
	get /caddy/log-snippet returns (CaddyLogSnippetResp)

	@handler UpdateCaddyLogSnippet
	put /caddy/log-snippet (CaddyLogSnippetUpdateReq) returns (CaddyLogSnippetResp)

	@handler ResetCaddyLogSnippet
	post /caddy/log-snippet/reset-default returns (CaddyLogSnippetResp)
}
